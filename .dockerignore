# Keep the build context small and secret-free. Context is the repo root, so
# both the backend and frontend builds share this file.

# Secrets — must never enter an image.
.env
.env.*

# Python
backend/.venv/
**/__pycache__/
**/*.py[cod]
.pytest_cache/
.ruff_cache/

# Node / Vite (reinstalled and rebuilt inside the image)
frontend/node_modules/
frontend/dist/
.vite/

# Local data
*.db
*.sqlite
*.sqlite3

# Docs and scratch not needed at runtime
PLAN.md
PROGRESS.md
.git/
.gitignore
.idea/
.vscode/
