# Copy to .env and fill in. NEVER commit .env.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optional. Sent as OpenRouter attribution headers (HTTP-Referer / X-Title).
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_SITE_NAME=LLM Chess Arena

# Optional. Overrides config.yaml's mode. live | mock
# MODE=mock
